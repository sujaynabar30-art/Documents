import os

# Clear the screen once at the very beginning
os.system('cls' if os.name == 'nt' else 'clear')

print("Welcome to the Mini Calculator!!!")

# The 'while True:' loop starts here. Everything indented underneath it will repeat forever!
while True:
    print("\n====================")
    print("       MENU")
    print("====================")
    print("Please Enter 1 for addition and press Enter to continue")
    print("Please Enter 2 for subtraction and press Enter to continue")
    print("Please Enter 3 for multiplication and press Enter to continue")
    print("Please Enter 4 for division and press Enter to continue")
    print("Please Enter 5 to QUIT")

    user_choice = input("\nEnter your choice (1-5): ")

    # 1. Check if they want to quit BEFORE asking for numbers
    if user_choice == '5':
        print("Thanks for using Sujay's calculator! Goodbye!")
        break  # <--- This is the magic word that kills the infinite loop

    # 2. Check if they picked a valid math option (1, 2, 3, or 4)
    if user_choice in ['1', '2', '3', '4']:
        # Now we ask for the numbers!
        # We use try/except to catch users typing letters instead of numbers.
        try:
            num1 = float(input("Enter the first number and press Enter to continue: "))
            num2 = float(input("Enter the second number and press Enter to continue: "))
        except ValueError:
            print("\nError: Invalid input! You must enter a valid number (e.g., 5 or 2.5).")
            input("Press Enter to try again...")
            os.system('cls' if os.name == 'nt' else 'clear')
            continue # Skip the math below and restart the loop from the top!

        print("\n--- RESULT ---")
        if user_choice == '1':
            result = num1 + num2
            print(f"The result of {num1} + {num2} is: {result}")
        elif user_choice == '2':
            result = num1 - num2
            print(f"The result of {num1} - {num2} is: {result}")
        elif user_choice == '3':
            result = num1 * num2
            print(f"The result of {num1} * {num2} is: {result}")
        elif user_choice == '4':
            if num2 != 0:
                result = num1 / num2
                print(f"The result of {num1} / {num2} is: {result}")
            else:
                print("Error: Cannot divide by zero.")
        
        # 3. Pause so the user can read the answer before the loop restarts
        input("\nPress Enter to do another calculation...")
        os.system('cls' if os.name == 'nt' else 'clear') # Clear screen for the next round

    else:
        # If they type '9' or 'apple'
        print("Invalid choice. Please enter a number between 1 and 5.")
        input("\nPress Enter to try again...")
        os.system('cls' if os.name == 'nt' else 'clear')